generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DebateVisibility {
  PUBLIC
  PRIVATE
}

enum DebateStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum DebateParticipantRole {
  MODERATOR
  DEBATER
  AUDIENCE
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  INVITED
}

enum DebateRoundType {
  OPENING_STATEMENT
  MAIN_ARGUMENT
  REBUTTAL
  CLOSING_STATEMENT
  CUSTOM
}

enum DebateRoundStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum ClaimProcessingStatus {
  DETECTED
  CHECKING
  COMPLETED
  FAILED
}

enum FactCheckVerdict {
  SUPPORTED
  REFUTED
  PARTIALLY_SUPPORTED
  CONTRADICTORY_EVIDENCE
  INSUFFICIENT_EVIDENCE
}

enum EvidenceSourceType {
  GOVERNMENT
  RESEARCH_PAPER
  NEWS
  ORGANIZATION
  OTHER
}

model User {
  id          String   @id @db.Uuid
  username    String?  @unique
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  hostedDebates Debate[] @relation("DebateHost")

  debateParticipations DebateParticipant[]

  votes Vote[]

  @@map("profiles")
}

model Debate {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  topic       String
  description String?
  category        String?
  durationMinutes Int              @default(30)
  visibility  DebateVisibility @default(PUBLIC)
  status      DebateStatus     @default(DRAFT)
  hostId      String           @db.Uuid
  maxDebaters Int              @default(2)
  startsAt    DateTime?        @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  host User @relation("DebateHost", fields: [hostId], references: [id], onDelete: Restrict)

  participants DebateParticipant[]

  rounds DebateRound[]

  transcripts Transcript[]

  votes Vote[]

  report DebateReport?

  debateEvidence DebateEvidence[]

  factualClaims FactualClaim[]

  topicBrief DebateTopicBrief?

  precheckSubmissions DebatePrecheckSubmission[]

  @@index([visibility, status])
  @@index([hostId])
  @@map("debates")
}

model DebateParticipant {
  id        String                @id @default(uuid()) @db.Uuid
  debateId  String                @db.Uuid
  userId    String                @db.Uuid
  role      DebateParticipantRole
  status    ParticipantStatus     @default(PENDING)
  joinedAt  DateTime?             @db.Timestamptz(6)
  createdAt DateTime              @default(now()) @db.Timestamptz(6)

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transcripts Transcript[]

  votesReceived Vote[] @relation("VoteTarget")

  factualClaims FactualClaim[]

  precheckSubmissions DebatePrecheckSubmission[]

  @@unique([debateId, userId])
  @@index([debateId, role, status])
  @@index([userId, status])
  @@map("debate_participants")
}

model DebateRound {
  id              String            @id @default(uuid()) @db.Uuid
  debateId        String            @db.Uuid
  roundNumber     Int
  title           String
  type            DebateRoundType   @default(CUSTOM)
  durationSeconds Int               @default(120)
  status          DebateRoundStatus @default(PENDING)
  instructions    String?
  startedAt       DateTime?         @db.Timestamptz(6)
  endedAt         DateTime?         @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  transcripts Transcript[]

  @@unique([debateId, roundNumber])
  @@index([debateId, status])
  @@map("debate_rounds")
}

model Transcript {
  id            String    @id @default(uuid()) @db.Uuid
  debateId      String    @db.Uuid
  roundId       String?   @db.Uuid
  participantId String?   @db.Uuid
  text          String
  language      String?
  isFinal       Boolean   @default(false)
  startedAt     DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  debate      Debate             @relation(fields: [debateId], references: [id], onDelete: Cascade)
  round       DebateRound?       @relation(fields: [roundId], references: [id], onDelete: SetNull)
  participant DebateParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  factualClaims FactualClaim[]

  @@index([debateId, createdAt])
  @@index([roundId, createdAt])
  @@index([participantId])
  @@map("transcripts")
}

model Vote {
  id                    String   @id @default(uuid()) @db.Uuid
  debateId              String   @db.Uuid
  voterUserId           String   @db.Uuid
  votedForParticipantId String   @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  voter User @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  votedFor DebateParticipant @relation("VoteTarget", fields: [votedForParticipantId], references: [id], onDelete: Cascade)

  @@unique([debateId, voterUserId])
  @@index([debateId, votedForParticipantId])
  @@map("votes")
}

model DebateReport {
  id          String   @id @default(uuid()) @db.Uuid
  debateId    String   @unique @db.Uuid
  summary     String
  reportData  Json
  generatedAt DateTime @default(now()) @db.Timestamptz(6)

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@map("debate_reports")
}

model EvidenceSource {
  id               String             @id @default(uuid()) @db.Uuid
  title            String
  publisher        String?
  url              String             @unique
  publishedAt      DateTime?          @db.Timestamptz(6)
  retrievedAt      DateTime           @default(now()) @db.Timestamptz(6)
  sourceType       EvidenceSourceType @default(OTHER)
  reliabilityNotes String?
  contentHash      String?

  chunks         EvidenceChunk[]
  debateEvidence DebateEvidence[]

  @@index([publisher])
  @@index([sourceType])
  @@map("evidence_sources")
}

model EvidenceChunk {
  id         String   @id @default(uuid()) @db.Uuid
  sourceId   String   @db.Uuid
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  source            EvidenceSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  factCheckEvidence FactCheckEvidence[]

  embedding Unsupported("vector(768)")?

  @@unique([sourceId, chunkIndex])
  @@index([sourceId])
  @@map("evidence_chunks")
}

model DebateEvidence {
  id             String   @id @default(uuid()) @db.Uuid
  debateId       String   @db.Uuid
  sourceId       String   @db.Uuid
  relevanceScore Float?
  addedAt        DateTime @default(now()) @db.Timestamptz(6)

  debate Debate         @relation(fields: [debateId], references: [id], onDelete: Cascade)
  source EvidenceSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([debateId, sourceId])
  @@index([debateId])
  @@map("debate_evidence")
}

model FactualClaim {
  id              String                @id @default(uuid()) @db.Uuid
  debateId        String                @db.Uuid
  transcriptId    String                @db.Uuid
  participantId   String?               @db.Uuid
  originalText    String
  normalizedClaim String
  language        String?
  status          ClaimProcessingStatus @default(DETECTED)
  detectedAt      DateTime              @default(now()) @db.Timestamptz(6)

  debate      Debate             @relation(fields: [debateId], references: [id], onDelete: Cascade)
  transcript  Transcript         @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  participant DebateParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  results     FactCheckResult[]

  @@index([debateId, detectedAt])
  @@index([transcriptId])
  @@index([status])
  @@map("factual_claims")
}

model FactCheckResult {
  id          String           @id @default(uuid()) @db.Uuid
  claimId     String           @db.Uuid
  modelName   String
  verdict     FactCheckVerdict
  confidence  Float?
  explanation String
  checkedAt   DateTime         @default(now()) @db.Timestamptz(6)

  claim    FactualClaim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence FactCheckEvidence[]

  @@index([claimId, checkedAt])
  @@map("fact_check_results")
}

model FactCheckEvidence {
  id                String   @id @default(uuid()) @db.Uuid
  factCheckResultId String   @db.Uuid
  evidenceChunkId   String   @db.Uuid
  relevanceScore    Float?
  supportsClaim     Boolean?

  factCheckResult FactCheckResult @relation(fields: [factCheckResultId], references: [id], onDelete: Cascade)
  evidenceChunk   EvidenceChunk   @relation(fields: [evidenceChunkId], references: [id], onDelete: Cascade)

  @@unique([factCheckResultId, evidenceChunkId])
  @@index([factCheckResultId])
  @@map("fact_check_evidence")
}

model DebateTopicBrief {
  id          String   @id @default(uuid()) @db.Uuid
  debateId    String   @unique @db.Uuid
  coreSummary String
  briefData   Json
  modelName   String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  debate Debate @relation(fields: [debateId], references: [id], onDelete: Cascade)

  @@map("debate_topic_briefs")
}

model DebatePrecheckSubmission {
  id              String   @id @default(uuid()) @db.Uuid
  debateId        String   @db.Uuid
  participantId   String   @db.Uuid
  questionId      String
  questionText    String
  debaterResponse String
  isValid         Boolean  @default(false)
  score           Float?
  feedback        String
  suggestion      String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  debate      Debate            @relation(fields: [debateId], references: [id], onDelete: Cascade)
  participant DebateParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([debateId, participantId, questionId])
  @@index([debateId, participantId])
  @@map("debate_precheck_submissions")
}
